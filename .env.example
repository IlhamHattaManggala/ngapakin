APP_NAME=Larapak
APP_ENV=local
APP_DEBUG=bener
APP_HOST=127.0.0.1
APP_PORT=8000
APP_KEY=secret_larapak_key_2026

# Database Configuration (Driver: sqlite, mysql, pgsql)
DB_CONNECTION=sqlite
DB_DATABASE=database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_DEBUG=salah
DB_TIMEOUT=30.0
DB_WAL=bener

# Storage Separation (Optional: separate SQLite files to eliminate contention)
# SESSION_DATABASE=storage/sessions.sqlite
# CACHE_DATABASE=storage/cache.sqlite
# QUEUE_DATABASE=storage/queue.sqlite

# Cache & Queue Driver (sqlite or redis)
CACHE_DRIVER=sqlite
QUEUE_DRIVER=sqlite

# Redis Configuration (When CACHE_DRIVER or QUEUE_DRIVER is redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Upload Controls
CSRF_EXEMPT_ROUTES=/api/webhook/*,/public-api/*
MAX_UPLOAD_SIZE=10485760
