{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Ngapak",
    "scopeName": "source.ngpk",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.ngpk",
                    "match": "#.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ngpk",
                    "match": "\\b(nek|ya|liyane|rampung|baleni|saka|nganti|gawe|balekna|kelas|extends)\\b"
                },
                {
                    "name": "support.function.ngpk",
                    "match": "\\b(tulis)\\b"
                },
                {
                    "name": "constant.language.ngpk",
                    "match": "\\b(bener|salah|kosong)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ngpk",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ngpk",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.ngpk",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ngpk",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.ngpk",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        }
    }
}
