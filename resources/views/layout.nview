<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Larapak</title>
    <link rel="icon" type="image/png" href="data:image/png;base64,">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/rikat.css">
    <script src="/js/rikat.js"></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            background-color: #0a0a0a;
            color: #ededec;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.5rem 2.5rem;
            overflow-x: hidden;
            line-height: 1.5;
        }
        .top-nav {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 1.5rem;
            font-size: 0.875rem;
        }
        .top-nav a {
            color: #a1a1aa;
            text-decoration: none;
            transition: color 0.15s ease;
        }
        .top-nav a:hover {
            color: #ffffff;
        }
        .center-container {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 0;
            flex-grow: 1;
        }
        .laravel-card {
            display: grid;
            grid-template-columns: 1fr 1fr;
            max-width: 920px;
            width: 100%;
            min-height: 440px;
            background-color: #161615;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        }
        .panel-left {
            padding: 3.5rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .panel-title {
            font-size: 1.05rem;
            font-weight: 600;
            color: #f4f4f5;
            margin-bottom: 0.5rem;
        }
        .panel-desc {
            font-size: 0.875rem;
            color: #a1a1aa;
            line-height: 1.6;
            margin-bottom: 2rem;
            max-width: 360px;
        }
        .stepper-list {
            display: flex;
            flex-direction: column;
            margin-bottom: 2.25rem;
        }
        .stepper-item {
            display: flex;
            align-items: flex-start;
            gap: 0.85rem;
            position: relative;
        }
        .stepper-indicator {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 3px;
        }
        .stepper-circle {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 1.5px solid #52525b;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #18181b;
        }
        .stepper-circle-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #f58220;
        }
        .stepper-line {
            width: 1px;
            height: 28px;
            background-color: #3f3f46;
            margin: 4px 0;
        }
        .stepper-content {
            font-size: 0.875rem;
            color: #e4e4e7;
            padding-top: 1px;
        }
        .stepper-content a {
            color: #f58220;
            text-decoration: underline;
            text-underline-offset: 3px;
            transition: color 0.15s ease;
        }
        .stepper-content a:hover {
            color: #ff9d47;
        }
        .stepper-arrow {
            display: inline-block;
            font-size: 0.85rem;
            color: #a1a1aa;
            margin-left: 2px;
        }
        .btn-deploy {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: #ffffff;
            color: #09090b;
            font-size: 0.875rem;
            font-weight: 600;
            padding: 0.65rem 1.25rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            align-self: flex-start;
            transition: background-color 0.15s ease, transform 0.1s ease;
        }
        .btn-deploy:hover {
            background-color: #e4e4e7;
            transform: translateY(-1px);
        }
        .btn-deploy:active {
            transform: translateY(0);
        }
        .panel-right {
            position: relative;
            background: radial-gradient(circle at 70% 30%, #2b0e06 0%, #150603 50%, #0d0402 100%);
            border-left: 1px solid rgba(255, 255, 255, 0.05);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .hero-wordmark {
            position: absolute;
            top: 1.5rem;
            left: 2rem;
            font-size: 4.8rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            color: #eb4432;
            opacity: 0.88;
            user-select: none;
            pointer-events: none;
            line-height: 1;
        }
        .wireframe-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0.55;
        }
        .logo-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-top: 3.5rem;
        }
        .hero-brand-art {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
            transition: transform 0.4s ease;
        }
        .hero-brand-art:hover {
            transform: scale(1.02);
        }
        .brand-emblem {
            width: 180px;
            height: 180px;
            object-fit: contain;
            filter: drop-shadow(0 12px 28px rgba(245, 130, 32, 0.35));
            transition: transform 0.3s ease;
        }
        .brand-emblem:hover {
            transform: scale(1.05);
        }
        footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
            color: #71717a;
            padding-top: 1rem;
        }
        footer a {
            color: #a1a1aa;
            text-decoration: none;
        }
        footer a:hover {
            color: #f58220;
            text-decoration: underline;
        }
        @media (max-width: 820px) {
            .laravel-card {
                grid-template-columns: 1fr;
            }
            .panel-right {
                min-height: 280px;
            }
            .hero-wordmark {
                font-size: 3.5rem;
            }
            .panel-left {
                padding: 2.5rem 1.75rem;
            }
        }
    </style>
</head>
<body>
    <nav class="top-nav">
        <a href="/status">API Status</a>
        <a href="https://ilhamhattamanggala.my.id" target="_blank" rel="noopener noreferrer">Portofolio</a>
    </nav>

    <div class="center-container">
        @yield "content"
    </div>

    <footer>
        <span>Larapak v1.0.8 (NgapakIn VM)</span>
        <span>Digawe dening <strong>Ilham Hatta Manggala</strong> &bull; <a href="https://ilhamhattamanggala.my.id" target="_blank" rel="noopener noreferrer">ilhamhattamanggala.my.id</a></span>
    </footer>

    <script>
        function copyCommand(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const original = btn.innerText;
                btn.innerText = 'Kasil Disalin!';
                btn.style.color = '#10b981';
                setTimeout(() => {
                    btn.innerText = original;
                    btn.style.color = '';
                }, 2000);
            });
        }
    </script>
</body>
</html>
