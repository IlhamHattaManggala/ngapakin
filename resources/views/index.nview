@layout "layout.nview"

@section "content"
<div class="laravel-card">
    <div class="panel-left">
        <h2 class="panel-title">Let's get started</h2>
        <p class="panel-desc">
            Larapak nduweni ekosistem MVC sing cepet lan enteng. Sampeyan bisa miwiti nganggo langkah-langkah ing ngisor iki.
        </p>

        <div class="stepper-list">
            <div class="stepper-item">
                <div class="stepper-indicator">
                    <span class="stepper-circle">
                        <span class="stepper-circle-dot"></span>
                    </span>
                    <span class="stepper-line"></span>
                </div>
                <div class="stepper-content">
                    Waca <a href="https://larapak.my.id" target="_blank" rel="noopener noreferrer">Dokumentasi NgapakIn</a>
                    <span class="stepper-arrow">&nearr;</span>
                </div>
            </div>

            <div class="stepper-item">
                <div class="stepper-indicator">
                    <span class="stepper-circle">
                        <span class="stepper-circle-dot"></span>
                    </span>
                    <span class="stepper-line"></span>
                </div>
                <div class="stepper-content">
                    Priksa <a href="/status">Status Layanan &amp; Rute API</a>
                    <span class="stepper-arrow">&nearr;</span>
                </div>
            </div>

            <div class="stepper-item">
                <div class="stepper-indicator">
                    <span class="stepper-circle">
                        <span class="stepper-circle-dot"></span>
                    </span>
                </div>
                <div class="stepper-content">
                    Portofolio Pangripta: <a href="https://ilhamhattamanggala.my.id" target="_blank" rel="noopener noreferrer">Ilham Hatta Manggala</a>
                    <span class="stepper-arrow">&nearr;</span>
                </div>
            </div>
        </div>

        <a href="https://larapak.my.id" target="_blank" rel="noopener noreferrer" class="btn-deploy">
            Lihat Dokumentasi
        </a>
    </div>

    <div class="panel-right">
        <img src="data:image/jpeg;base64," onerror="this.onerror=null; this.src='/images/logo.png';" alt="NgapakIn Logo" class="hero-brand-art">
    </div>
</div>
@rampung
